# ── OS / editor junk ─────────────────────────────────────────
.DS_Store
*.asv                       # MATLAB autosave
.ipynb_checkpoints/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.env
.venv/
.vscode/
.ruff_cache/

# ── Datasets (generated by simulation_matlab/generate_radar_dataset.m) ──
alg_pdisac/data/*.db

# ── Training outputs: checkpoints + figures (keep the folder) ─
alg_pdisac/exps/*
!alg_pdisac/exps/.gitkeep

# ── MATLAB figures (keep the folder) ─────────────────────────
simulation_matlab/fig_exported/*
!simulation_matlab/fig_exported/.gitkeep

# ── MATLAB exported statistics: CSV/MAT data (keep the folder) ─
simulation_matlab/exported_statistics/*
!simulation_matlab/exported_statistics/.gitkeep
